{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "remotory",
  "main": "worker.ts",
  "compatibility_date": "2026-08-19",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "remotory-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "db/migrations",
      "remote": false,
    },
  ],
  "ai": {
    "binding": "AI",
    "remote": true,
  },
  "workflows": [
    {
      "name": "remotory-company-update",
      "binding": "COMPANY_UPDATE_WORKFLOW",
      "class_name": "CompanyUpdateWorkflow",
    },
  ],
  "observability": {
    "enabled": true,
  },
}
