# Cloudflare Access team domain, including https:// and no path.
CLOUDFLARE_ACCESS_TEAM_DOMAIN=

# Application Audience (AUD) tag copied from the Access application.
CLOUDFLARE_ACCESS_AUD=

# Single administrator email address allowed by the application layer.
REMOTORY_ADMIN_EMAIL=

# Local next dev only. Set to true explicitly in .env.local to bypass Access.
# This flag is ignored unless NODE_ENV is exactly development.
REMOTORY_AUTH_DEV_BYPASS=false

# Local next dev only. Set to true to use remote Cloudflare bindings explicitly.
# Workers AI usage may incur charges. Keep false for tests and ordinary builds.
REMOTORY_ENABLE_REMOTE_BINDINGS=false

# Public site origin without a path, for example https://directory.example.
# Set the real hostname in Step 11. Local development defaults to localhost.
REMOTORY_SITE_URL=

# Keep false for local and preview. Enable only for the reviewed production host.
REMOTORY_ALLOW_INDEXING=false
